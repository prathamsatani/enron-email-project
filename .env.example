# Gmail Configuration
GMAIL_ACCOUNT=your-gmail@gmail.com
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=gmail_token.json

# MCP Configuration
MCP_SERVER_URL=http://localhost:3000
MCP_CONFIG_PATH=./mcp_config.json

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_PATH=./data/output/database.db

# Output Directories
OUTPUT_DIR=./data/output
ERROR_LOG_PATH=./data/output/error_log.txt
DUPLICATES_REPORT_PATH=./data/output/duplicates_report.csv
SEND_LOG_PATH=./data/output/send_log.csv

# Email Notification Settings
SEND_LIVE_EMAILS=false
NOTIFICATION_ENABLED=false
DRY_RUN_MODE=true
